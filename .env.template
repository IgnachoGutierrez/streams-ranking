# Copy to .env (ignored by git) and fill in. Read by docker compose.

# Public origin of the app, no trailing slash. The Spotify redirect URI is
# derived from it: <APP_ORIGIN>/api/auth/callback - register exactly that URL
# in the Spotify app settings.
APP_ORIGIN=http://127.0.0.1:8080

# Host name the app is served on (nginx server_name): the host part of
# APP_ORIGIN. Locally this is 127.0.0.1, not localhost, because Spotify does
# not accept localhost redirect URIs.
APP_DOMAIN=127.0.0.1

# Retired site whose traffic is redirected to APP_ORIGIN. The www. variant is
# covered automatically. Leave empty to disable the redirect (e.g. on QA);
# with TLS, a non-empty value needs a certificate for this domain.
LEGACY_DOMAIN=old-site.example

# Host port for plain HTTP (base compose file only; production uses 80/443).
HTTP_PORT=8080

# Spotify app credentials.
CLIENT_ID=
CLIENT_SECRET=

# Optional: Last.fm API key, used for artist genres.
LASTFM_API_KEY=

# Optional: Google Analytics 4 measurement ID (G-XXXXXXXXXX). Built into the
# client bundle, so rebuild after changing it: docker compose up -d --build.
# Leave empty to disable analytics (e.g. on QA or in forks).
GA_MEASUREMENT_ID=

# Production: uncomment so every `docker compose` command includes TLS.
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
